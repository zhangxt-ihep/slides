{
  "name": "ihep-fts-workshop-report",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "slidev slides/fts-xrootd-workshop-2026/slides.md --bind 127.0.0.1 --port 3030",
    "build": "slidev build slides/fts-xrootd-workshop-2026/slides.md --without-notes",
    "export": "slidev export slides/fts-xrootd-workshop-2026/slides.md --per-slide --output qa/output/FTS_IHEP_v2.pdf",
    "check": "node qa/check-v2.mjs && node qa/check-juno-map.mjs"
  },
  "devDependencies": {
    "@fontsource/arimo": "5.3.0",
    "@slidev/cli": "52.19.1",
    "playwright-chromium": "1.63.0",
    "slidev-theme-scholarly": "1.4.1",
    "vue": "3.5.42"
  },
  "dependencies": {
    "slidev-theme-neversink": "^0.4.1"
  }
}
